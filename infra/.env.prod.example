# ═══════════════════════════════════════════════════════════════════
#  Variáveis da VM de produção.
#  Copie para /opt/ihome/.env na máquina e preencha.
#  Este arquivo NUNCA vai para o Git.
# ═══════════════════════════════════════════════════════════════════

# Domínio público. Com o rótulo DNS do Azure fica algo como:
#   ihome-prod.eastus.cloudapp.azure.com
# É para ele que o Caddy pedirá o certificado.
DOMINIO=

# Usuário do GitHub em minúsculas — compõe o caminho da imagem no GHCR.
GITHUB_REPO=dudufritz

# ── Banco ──
POSTGRES_USER=ihome
POSTGRES_PASSWORD=

# ── Segredos da aplicação ──
# Gere cada um com:  openssl rand -hex 32
# ⚠️ Guarde fora da VM. Perder ENCRYPTION_KEY torna os segredos Tuya
#    já cifrados irrecuperáveis.
JWT_SECRET=
ENCRYPTION_KEY=

# ── Integrações (opcionais; sem elas o recurso apenas não funciona) ──
GEMINI_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:seu-email@gmail.com
NEW_RELIC_LICENSE_KEY=
