# ═══════════════════════════════════════════════════════════════════
#  iHome — variáveis de ambiente
#  Copie para .env e preencha. NUNCA versione o .env de verdade.
# ═══════════════════════════════════════════════════════════════════

# ── Servidor ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Banco de dados (Azure PostgreSQL Flexible Server) ──────────────
# Obrigatória. Sem ela o servidor sobe mas nenhuma rota funciona.
DATABASE_URL=postgresql://usuario:senha@host:5432/ihome?sslmode=require

# ── Autenticação (emitida pelo próprio iHome) ──────────────────────
# ⚠️ OBRIGATÓRIA. Segredo que assina os access tokens (HS256).
# Sem ela nenhum login funciona. Gere com:  npm run gen:key
# Trocá-la invalida todas as sessões ativas — o que é exatamente o que
# você quer fazer se suspeitar que ela vazou.
JWT_SECRET=

# Validade do access token. Curta de propósito: se vazar, a janela é pequena.
ACCESS_TOKEN_TTL=15m
# Validade do refresh token, em dias. É ele que evita pedir a senha toda hora.
REFRESH_TOKEN_DAYS=30
# Custo do bcrypt. 12 ≈ 250ms por hash. Não baixe em produção.
BCRYPT_ROUNDS=12
# Validade dos links enviados por e-mail.
RESET_TOKEN_MINUTES=60
VERIFY_TOKEN_HOURS=48

# ── Criptografia dos segredos Tuya ─────────────────────────────────
# ⚠️ IMPORTANTE: sem esta chave o tuya_secret é gravado EM TEXTO PURO.
# O app funciona, mas sem a proteção. Gere a sua com:
#     npm run gen:key
# São 32 bytes em hexadecimal (64 caracteres).
#
# ⚠️ Se você PERDER esta chave, os segredos já cifrados ficam irrecuperáveis
# e cada usuário precisará recadastrar as credenciais Tuya. Guarde-a no
# cofre de variáveis do Azure (App Settings ou Key Vault), não no repositório.
ENCRYPTION_KEY=

# ── URLs públicas ───────────────────────────────────────────────────
# Usadas nos links do e-mail (convite, redefinição, confirmação) e na
# allowlist do CORS. Sem valor correto aqui, os links do e-mail apontam
# para o lugar errado e o navegador bloqueia o frontend.
BACKEND_URL=https://sua-api.azurewebsites.net
FRONTEND_URL=https://seu-app.azurestaticapps.net

# Origens extras permitidas pelo CORS, separadas por vírgula.
# FRONTEND_URL já entra automaticamente; use isto para ambientes de preview.
CORS_EXTRA_ORIGINS=

# ── Limitação de requisições ────────────────────────────────────────
# Janela em minutos e teto por janela.
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_GLOBAL=300        # geral, por IP
RATE_LIMIT_AUTH=10           # login/cadastro/recuperação — trava força bruta
RATE_LIMIT_AI=30             # /ai-command chama API paga

# ── Convites ────────────────────────────────────────────────────────
# Dias de validade do convite de compartilhamento.
INVITE_EXPIRY_DAYS=7

# ── E-mail de convite (Gmail SMTP) ─────────────────────────────────
# GMAIL_APP_PASSWORD é a "senha de app" gerada na conta Google,
# não a senha normal da conta.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Notificações push (Web Push / VAPID) ───────────────────────────
# Gere o par com:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@ihomeauto.com

# ── Assistente de IA (Google Gemini) ───────────────────────────────
# Obtida em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Observabilidade (New Relic) ────────────────────────────────────
# Se ausente, o agente simplesmente não é carregado.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=iHome API

# ── Regras de negócio ajustáveis ───────────────────────────────────
# Dias que o registro de auditoria mantém antes do expurgo automático.
AUDIT_RETENTION_DAYS=90
# Intervalo do monitor de conectividade, em milissegundos (padrão: 5 min).
MONITOR_INTERVAL_MS=300000
